# NAX5: generate nax5_build.h at BUILD time (not configure time), so the sha in the
# binary matches the tree that was actually compiled. Rewrites the header only when
# its content changed, so dependent objects are not recompiled on every build.
# Arguments (-D): OUT, SRC_DIR, GIT (may be empty), FALLBACK_SHA

set(describe "")
set(sha "")
if(GIT)
	execute_process(
		COMMAND "${GIT}" describe --always --tags --abbrev=12
		WORKING_DIRECTORY "${SRC_DIR}"
		OUTPUT_VARIABLE describe
		OUTPUT_STRIP_TRAILING_WHITESPACE
		ERROR_QUIET
		RESULT_VARIABLE describe_result
	)
	if(NOT describe_result EQUAL 0)
		set(describe "")
	endif()
	execute_process(
		COMMAND "${GIT}" rev-parse --short=12 HEAD
		WORKING_DIRECTORY "${SRC_DIR}"
		OUTPUT_VARIABLE sha
		OUTPUT_STRIP_TRAILING_WHITESPACE
		ERROR_QUIET
		RESULT_VARIABLE sha_result
	)
	if(NOT sha_result EQUAL 0)
		set(sha "")
	endif()
endif()
# Two builds from different uncommitted edits of the same commit must not share an id:
# append a short hash of the diff against HEAD (e.g. c97e4b9a2a88-dirty.1f3a9c02).
# Submodules are ignored: third-party sources unpacked without their own .git always
# look modified and would mark every build dirty.
if(describe AND GIT)
	execute_process(
		COMMAND "${GIT}" diff HEAD --ignore-submodules
		WORKING_DIRECTORY "${SRC_DIR}"
		OUTPUT_VARIABLE dirty_diff
		ERROR_QUIET
		RESULT_VARIABLE diff_result
	)
	if(diff_result EQUAL 0 AND NOT dirty_diff STREQUAL "")
		string(SHA1 dirty_hash "${dirty_diff}")
		string(SUBSTRING "${dirty_hash}" 0 8 dirty_hash)
		set(describe "${describe}-dirty.${dirty_hash}")
	endif()
endif()
if(NOT sha)
	if(FALLBACK_SHA)
		set(sha "${FALLBACK_SHA}")
	else()
		set(sha "unknown")
	endif()
endif()
if(NOT describe)
	set(describe "${sha}")
endif()

set(content "// Generated by gui/cmake/nax5_build_id.cmake at build time. Do not edit.
#ifndef NAX5_BUILD_H
#define NAX5_BUILD_H
#define NAX5_BUILD_SHA \"${sha}\"
#define NAX5_BUILD_DESCRIBE \"${describe}\"
#endif
")

set(old "")
if(EXISTS "${OUT}")
	file(READ "${OUT}" old)
endif()
if(NOT old STREQUAL content)
	get_filename_component(out_dir "${OUT}" DIRECTORY)
	file(MAKE_DIRECTORY "${out_dir}")
	file(WRITE "${OUT}" "${content}")
endif()
